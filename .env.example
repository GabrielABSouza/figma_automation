# LLM Provider — Gemini (primary)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-flash-preview     # gemini-3-flash-preview | gemini-2.5-flash | gemini-2.5-pro
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=16384
GEMINI_MAX_RETRIES=2
GEMINI_THINKING_BUDGET=1024            # max thinking tokens (0 = disable thinking)

# Figma
FIGMA_ACCESS_TOKEN=figd_...

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/figma_automation

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development                     # development | staging | production
LOG_LEVEL=INFO
